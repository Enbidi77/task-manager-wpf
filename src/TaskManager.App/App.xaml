<Application x:Class="TaskManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TaskManager.App.Views"
             xmlns:converters="clr-namespace:TaskManager.App.Converters"
             xmlns:controls="clr-namespace:TaskManager.App.Controls"
             xmlns:vmDash="clr-namespace:TaskManager.Application.ViewModels.Dashboard;assembly=TaskManager.Application"
             xmlns:vmProc="clr-namespace:TaskManager.Application.ViewModels.Processes;assembly=TaskManager.Application"
             xmlns:vmPerf="clr-namespace:TaskManager.Application.ViewModels.Performance;assembly=TaskManager.Application"
             xmlns:vmServ="clr-namespace:TaskManager.Application.ViewModels.Services;assembly=TaskManager.Application"
             xmlns:vmStart="clr-namespace:TaskManager.Application.ViewModels.StartupApps;assembly=TaskManager.Application"
             xmlns:vmUsers="clr-namespace:TaskManager.Application.ViewModels.Users;assembly=TaskManager.Application"
             xmlns:vmSet="clr-namespace:TaskManager.Application.ViewModels.Settings;assembly=TaskManager.Application">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:BytesToSizeConverter x:Key="BytesToSizeConverter" />
            <converters:PercentageToColorConverter x:Key="PercentageToColorConverter" />
            <converters:TimeSpanToUptimeConverter x:Key="TimeSpanToUptimeConverter" />
            <converters:ProcessStatusConverter x:Key="ProcessStatusConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- ViewModel to View Mappings -->
            <DataTemplate DataType="{x:Type vmDash:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmProc:ProcessesViewModel}">
                <views:ProcessesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmPerf:PerformanceViewModel}">
                <views:PerformanceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmServ:ServicesViewModel}">
                <views:ServicesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmStart:StartupAppsViewModel}">
                <views:StartupAppsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmUsers:UsersViewModel}">
                <views:UsersView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vmSet:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
