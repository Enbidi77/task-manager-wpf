<UserControl x:Class="TaskManager.App.Controls.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:TaskManager.App.Converters"
             mc:Ignorable="d" 
             x:Name="RootIndicator">

    <UserControl.Resources>
        <converters:ProcessStatusConverter x:Key="StatusBrushConverter" />
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Colored Circle Dot -->
        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                 Fill="{Binding StatusText, ElementName=RootIndicator, Converter={StaticResource StatusBrushConverter}}"/>

        <!-- Status Label Text -->
        <TextBlock Text="{Binding StatusText, ElementName=RootIndicator}"
                   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
