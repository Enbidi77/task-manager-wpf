<UserControl x:Class="TaskManager.App.Controls.PerformanceChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             x:Name="RootChart">

    <Border Background="{DynamicResource ContentBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
        <Grid>
            <!-- Background Grid Lines -->
            <Canvas x:Name="GridCanvas" Opacity="0.15">
                <Line X1="0" Y1="25" X2="2000" Y2="25" Stroke="{DynamicResource TextPrimaryBrush}" StrokeDashArray="2,2"/>
                <Line X1="0" Y1="75" X2="2000" Y2="75" Stroke="{DynamicResource TextPrimaryBrush}" StrokeDashArray="2,2"/>
                <Line X1="0" Y1="125" X2="2000" Y2="125" Stroke="{DynamicResource TextPrimaryBrush}" StrokeDashArray="2,2"/>
            </Canvas>

            <!-- Real-time Area & Line Path -->
            <Path x:Name="AreaPath" Opacity="0.25"/>
            <Path x:Name="LinePath" StrokeThickness="2"/>

            <!-- Axis Labels -->
            <TextBlock Text="100%" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,4" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Text="50%" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Text="0%" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,4" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>

            <TextBlock Text="{Binding HeaderText, ElementName=RootChart}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/>
        </Grid>
    </Border>
</UserControl>
