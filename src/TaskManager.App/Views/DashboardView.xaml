<UserControl x:Class="TaskManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TaskManager.App.Controls"
             xmlns:converters="clr-namespace:TaskManager.App.Converters"
             xmlns:vm="clr-namespace:TaskManager.Application.ViewModels.Dashboard;assembly=TaskManager.Application"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">
            <!-- Header -->
            <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Real-time system telemetry and hardware performance metrics" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

            <!-- High Utilization Alert Banner -->
            <Border Background="#2B1A00" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCpuHighAlert}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMemoryHighAlert}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="High Resource Consumption Alert: System usage has exceeded 80% threshold." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Metric Cards Grid (CPU, Memory, Disk, Network) -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <controls:MetricCard Margin="0,0,10,0"
                                     Title="CPU"
                                     IconGlyph="&#xE9D9;"
                                     ValueText="{Binding CpuUsagePercent, StringFormat='{}{0:F1}%'}"
                                     PercentageValue="{Binding CpuUsagePercent}"
                                     DetailText="{Binding CpuDetailText}"/>

                <controls:MetricCard Margin="5,0,5,0"
                                     Title="Memory"
                                     IconGlyph="&#xE7F8;"
                                     ValueText="{Binding MemoryUsagePercent, StringFormat='{}{0:F1}%'}"
                                     PercentageValue="{Binding MemoryUsagePercent}"
                                     DetailText="{Binding MemoryDetailText}"/>

                <controls:MetricCard Margin="5,0,5,0"
                                     Title="Disk (Active)"
                                     IconGlyph="&#xEDA2;"
                                     ValueText="{Binding DiskUsagePercent, StringFormat='{}{0:F0}%'}"
                                     PercentageValue="{Binding DiskUsagePercent}"
                                     DetailText="{Binding DiskDetailText}"/>

                <controls:MetricCard Margin="10,0,0,0"
                                     Title="Network"
                                     IconGlyph="&#xE968;"
                                     ValueText="{Binding NetworkUsageMbps, StringFormat='{}{0:F1} Mbps'}"
                                     PercentageValue="{Binding NetworkUsageMbps}"
                                     DetailText="{Binding NetworkDetailText}"/>
            </UniformGrid>

            <!-- Real-time Historical Charts Grid -->
            <TextBlock Text="Historical Trends (60 Seconds)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <!-- CPU Chart -->
                <controls:PerformanceChart Grid.Row="0" Grid.Column="0" Margin="0,0,10,12"
                                           HeaderText="CPU Utilization History (%)"
                                           StrokeBrush="{DynamicResource AccentBrush}"
                                           Values="{Binding CpuHistory}"/>

                <!-- Memory Chart -->
                <controls:PerformanceChart Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"
                                           HeaderText="Memory Utilization History (%)"
                                           StrokeBrush="#A050DF"
                                           Values="{Binding MemoryHistory}"/>

                <!-- Disk Chart -->
                <controls:PerformanceChart Grid.Row="1" Grid.Column="0" Margin="0,0,10,0"
                                           HeaderText="Disk Active Time (%)"
                                           StrokeBrush="#0F7B0F"
                                           Values="{Binding DiskHistory}"/>

                <!-- Network Chart -->
                <controls:PerformanceChart Grid.Row="1" Grid.Column="1" Margin="0,0,0,0"
                                           HeaderText="Network Throughput (%)"
                                           StrokeBrush="#D89B00"
                                           Values="{Binding NetworkHistory}"/>
            </Grid>

            <!-- Secondary Metrics Section -->
            <Border Style="{DynamicResource FluentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="System Statistics" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <UniformGrid Grid.Row="1" Columns="4">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Processes" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ProcessCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="6,0,6,0">
                            <TextBlock Text="Threads" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ThreadCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="6,0,6,0">
                            <TextBlock Text="Handles" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding HandleCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Up Time" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding UptimeString}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
