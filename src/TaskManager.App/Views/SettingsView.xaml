<UserControl x:Class="TaskManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:TaskManager.Shared.Enums;assembly=TaskManager.Shared"
             xmlns:vm="clr-namespace:TaskManager.Application.ViewModels.Settings;assembly=TaskManager.Application"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
            <TextBlock Text="Configure appearance and application behavior" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,24" />

            <!-- Appearance Section -->
            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

            <Border Style="{DynamicResource FluentCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="App Theme" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Select which app theme to display" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Dark" Command="{Binding SwitchThemeCommand}" CommandParameter="{x:Static enums:AppTheme.Dark}" Style="{DynamicResource FluentSecondaryButtonStyle}" Margin="0,0,6,0" />
                        <Button Content="Light" Command="{Binding SwitchThemeCommand}" CommandParameter="{x:Static enums:AppTheme.Light}" Style="{DynamicResource FluentSecondaryButtonStyle}" Margin="0,0,6,0" />
                        <Button Content="Toggle" Command="{Binding ToggleThemeCommand}" Style="{DynamicResource FluentPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Window Behavior Section -->
            <TextBlock Text="Window Behavior" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,12" />

            <Border Style="{DynamicResource FluentCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Always on top" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Keep the Task Manager window floating above all other windows" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource FluentCardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Minimize on use" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Automatically minimize when switching focus to a selected process" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding MinimizeOnUse}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- About Section -->
            <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,12" />

            <Border Style="{DynamicResource FluentCardStyle}">
                <StackPanel>
                    <TextBlock Text="Modern Windows Task Manager" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Built with WPF, .NET 10 LTS, Clean Architecture, and Fluent Design System" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version: {0}'}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
