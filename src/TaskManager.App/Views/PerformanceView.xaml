<UserControl x:Class="TaskManager.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TaskManager.Application.ViewModels.Performance;assembly=TaskManager.Application"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PerformanceViewModel}">

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Performance" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Metric Selector List -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <!-- CPU Selector -->
                <Border Style="{DynamicResource FluentCardStyle}" Margin="0,0,0,8" Cursor="Hand" Background="{DynamicResource SubtleSelectedBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding CurrentCpuUsage, StringFormat='{}{0:F1}% {1:F2} GHz', ConverterParameter={x:Null}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Memory Selector -->
                <Border Style="{DynamicResource FluentCardStyle}" Margin="0,0,0,8" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Memory" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding MemoryInUseGb, StringFormat='{}{0:F1}/16.0 GB (59%)'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Disk Selector -->
                <Border Style="{DynamicResource FluentCardStyle}" Margin="0,0,0,8" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Disk 0 (C: SSD)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding DiskActivePercent, StringFormat='{}{0:F0}%'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Ethernet Selector -->
                <Border Style="{DynamicResource FluentCardStyle}" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ethernet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="S: 32 Kbps / R: 1.4 Mbps" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Detailed Graph & Stats View -->
            <Border Grid.Column="1" Style="{DynamicResource FluentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="False" Margin="0,0,0,16">
                        <TextBlock Text="CPU" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                        <TextBlock Text="Intel(R) Core(TM) i9-14900K Processor" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Graph Canvas Placeholder / Area -->
                    <Border Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                        <Grid>
                            <TextBlock Text="% Utilization (60 Seconds History)" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="100%" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,8" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock Text="0%" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,8" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>

                            <!-- Mock Real-time Wave preview -->
                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" VerticalAlignment="Bottom" Margin="0,0,0,20"
                                  Data="M 0,120 Q 50,40 100,90 T 200,60 T 300,100 T 400,30 T 500,80 T 600,45 L 600,160 L 0,160 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4060CDFF" Offset="0.0"/>
                                        <GradientStop Color="#0560CDFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Grid>
                    </Border>

                    <!-- Technical Specs Grid -->
                    <UniformGrid Grid.Row="2" Columns="4">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Utilization" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CurrentCpuUsage, StringFormat='{}{0:F1}%'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Speed" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CpuSpeedGhz, StringFormat='{}{0:F2} GHz'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="6,0,6,0">
                            <TextBlock Text="Processes" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CpuProcesses}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Threads" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CpuThreads}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="6,0,6,0">
                            <TextBlock Text="Handles" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CpuHandles}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sockets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="1" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Cores" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="24 (8P + 16E)" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Logical processors" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="32" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
